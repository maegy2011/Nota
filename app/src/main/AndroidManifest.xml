<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- التذكير: إشعار النظام + منبه دقيق + إعادة الجدولة بعد الإقلاع -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- ضمان الانطلاق: طلب الاستثناء من تحسين البطارية (اختياري — بموافقة صريحة ومرة واحدة) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- التسجيل الصوتي داخل الملاحظة — يُطلب وقت التسجيل فقط (ملفات داخلية .m4a) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- الموقع: اختياري لكل ملاحظة — يُطلب وقت الإرفاق فقط (ميزة مدفوعة) + GPS يعمل أوفلاين -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- INTERNET: لا تُستخدم إلا عند تسجيل الدخول وسؤال الاستحقاق (المرحلة 1+) — الوضع الافتراضي أوفلاين كما هو -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:name=".NotaApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/backup_rules"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nota">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.nota.notes.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
        <activity android:name=".MainActivity" android:exported="true"
            android:theme="@style/Theme.Nota">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- التذكير: انطلاق المنبه + إعادة الجدولة بعد الإقلاع (المنبهات لا تنجو منه) -->
        <receiver android:name=".geo.GeoReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.nota.notes.GEOFENCE" />
            </intent-filter>
        </receiver>
        <receiver android:name=".backup.BackupReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.nota.notes.SCHEDULED_BACKUP" />
            </intent-filter>
        </receiver>
        <receiver android:name=".reminder.ReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.nota.notes.REMIND" />
            </intent-filter>
        </receiver>
        <receiver android:name=".reminder.BootReceiver" android:exported="false">
            <!-- USER_UNLOCKED: التخزين المشفر يُتاح بعد أول فتح قفل — فيُعاد الجدولة حينها لا عند الإقلاع فقط -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
            </intent-filter>
        </receiver>
        <!-- ويدجت 4×2: آخر الملاحظات + زر إضافة (بلا تحديث دوري) -->
        <receiver android:name=".widget.NotaWidgetProvider" android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/nota_widget_info" />
        </receiver>
    </application>
</manifest>
